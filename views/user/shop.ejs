</form>
</div>

<!-- Mobile FILTER OVERLAY + DRAWER -->
<div class="filter-overlay" id="filterOverlay" onclick="closeFilterDrawer()"></div>

<div class="filter-drawer" id="filterDrawer">
  <div class="drawer-header">
    <h5>🔧 Filter By</h5>
    <button class="drawer-close" onclick="closeFilterDrawer()">✕</button>
  </div>
  <div class="drawer-body">
  
    <div class="filter-hdr">
      <h5 style="display:none">Filter By</h5>
      <a class="clear-all-btn" href="/shop">Clear all</a>
    </div>

    <div class="active-tags">
      <% activeTags.forEach(tag => { %>
        <span class="atag"><%= tag.label %><a href="<%= tag.url %>">✕</a></span>
      <% }) %>
    </div>

    <aside>
      <div class="fsec">
        <div class="fsec-title open" onclick="toggleFsec(this)"><span>Categories</span><span class="farr">▼</span></div>
        <div class="fsec-body open">
          <% categories.forEach(cat => { %>
            <div class="cat-parent" onclick="toggleSub(this,'sub-drawer-<%= cat._id %>')">
              <span><%= cat.name %></span><span class="cp-arr">▶</span>
            </div>
            <div class="sub-opts" id="sub-drawer-<%= cat._id %>">
              <% cat.subCategories.forEach(sub => { %>
                <label class="foption">
                  <input type="checkbox" name="subcategory" value="<%= sub._id %>"
                    form="shopFilterForm"
                    <%= selected.subcategory.includes(String(sub._id)) ? 'checked' : '' %>>
                  <%= sub.name %>
                </label>
              <% }) %>
            </div>
          <% }) %>
        </div>
      </div>

      <div class="fsec">
        <div class="fsec-title open" onclick="toggleFsec(this)"><span>Author</span><span class="farr">▼</span></div>
        <div class="fsec-body open">
          <% authors.forEach(a => { %>
            <label class="foption">
              <input type="checkbox" name="author" value="<%= a._id %>"
                form="shopFilterForm"
                <%= selected.author.includes(String(a._id)) ? 'checked' : '' %>>
              <%= a.name %>
            </label>
          <% }) %>
        </div>
      </div>

      <div class="fsec">
        <div class="fsec-title open" onclick="toggleFsec(this)"><span>Language</span><span class="farr">▼</span></div>
        <div class="fsec-body open">
          <% languages.forEach(l => { %>
            <label class="foption">
              <input type="checkbox" name="language" value="<%= l._id %>"
                form="shopFilterForm"
                <%= selected.language.includes(String(l._id)) ? 'checked' : '' %>>
              <%= l.languageName %>
            </label>
          <% }) %>
        </div>
      </div>

      <div class="fsec">
        <div class="fsec-title open" onclick="toggleFsec(this)"><span>Price (₹)</span><span class="farr">▼</span></div>
        <div class="fsec-body open">
          <div class="price-slider-wrap">
            <div class="price-range-labels">
              <span class="money-emoji">💵💵</span>
              <span id="priceLabelDrawer" class="range-val">₹0 – ₹<%= price %></span>
            </div>
            <input
              type="range"
              id="priceSliderDrawer"
              class="price-slider"
              form="shopFilterForm"
              name="price"
              min="0"
              max="<%= maxPrice %>"
              step="1"
              value="<%= price %>"
              oninput="onSliderInput(this,'priceLabelDrawer')">
          </div>
        </div>
      </div>

      <div class="fsec">
        <div class="fsec-title open" onclick="toggleFsec(this)"><span>Format</span><span class="farr">▼</span></div>
        <div class="fsec-body open">
          <label class="foption">
            <input type="checkbox" name="format" value="paperback" form="shopFilterForm"
              <%= selected.format.includes('paperback') ? 'checked' : '' %>>
            Paper Back
          </label>
          <label class="foption">
            <input type="checkbox" name="format" value="hardcover" form="shopFilterForm"
              <%= selected.format.includes('hardcover') ? 'checked' : '' %>>
            Hard Cover
          </label>
        </div>
      </div>

      <button class="apply-all-btn" type="submit" form="shopFilterForm">APPLY FILTERS</button>
    </aside>
  </div>
</div>

