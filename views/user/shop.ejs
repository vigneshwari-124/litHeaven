<div class="search-wrap">
  <form class="search-box" method="GET" action="/shop">
  <button type="submit" class="s-emoji">🔍</button>
  <input type="text" name="search" value="<%= search %>" placeholder="What are you looking for?" autocomplete="off">
  <% if(search){ %><a class="s-cancel show" href="<%= buildLink({ search: '', page: 1 }) %>" title="Clear">✕</a><% } %>
  <% if(sort){ %><input type="hidden" name="sort" value="<%= sort %>"><% } %>
  <% if(chip && chip !== 'new'){ %><input type="hidden" name="chip" value="<%= chip %>"><% } %>

  <% selected.category.forEach(v => { %><input type="hidden" name="category" value="<%= v %>"><% }) %>
  <% selected.subcategory.forEach(v => { %><input type="hidden" name="subcategory" value="<%= v %>"><% }) %>
  <% selected.author.forEach(v => { %><input type="hidden" name="author" value="<%= v %>"><% }) %>
  <% selected.language.forEach(v => { %><input type="hidden" name="language" value="<%= v %>"><% }) %>
  <% selected.format.forEach(v => { %><input type="hidden" name="format" value="<%= v %>"><% }) %>
